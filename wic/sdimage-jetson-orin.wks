# Jetson Orin Nano Super Developer Kit — A/B OTA SD card layout
#
# The Jetson Orin Nano Developer Kit boots from SD card via the UEFI firmware
# stored on the module's eMMC.  UEFI scans bootable partitions for
# /boot/extlinux/extlinux.conf.
#
# p1  /boot       256 MB   FAT32  kernel Image, DTBs, extlinux/extlinux.conf
# p2  /           8192 MB  ext4   rootfs-a  (active slot, built by BitBake)
# p3  <none>      8192 MB  ext4   rootfs-b  (standby slot, written by SWUpdate)
# p4  /home       512 MB → grows to fill card on first boot via arches-home-init
#
# p4 is mounted at /home so user home directories persist across OTA updates.
# On first boot arches-home-init.service creates /home/arches because the
# fresh empty partition hides the in-rootfs skeleton copy.
#
# SWUpdate writes the new rootfs to the inactive slot (p2 or p3) and
# updates /boot/extlinux/extlinux.conf root= to the new slot's PARTUUID.
# On the next reboot the updated slot becomes active.
#
# The SD card is /dev/mmcblk1 on the Jetson Orin Nano devkit
# (eMMC is /dev/mmcblk0 and is reserved for UEFI firmware).

part /boot --source bootimg-partition --ondisk mmcblk1 --fstype=vfat --label boot --active --align 4096 --fixed-size 256M

part / --source rootfs --ondisk mmcblk1 --fstype=ext4 --label rootfs-a --align 4096 --fixed-size 8192M

part --source empty --ondisk mmcblk1 --fstype=ext4 --label rootfs-b --align 4096 --fixed-size 8192M

# p4 is created at 512 MB here so the .wic image stays small.
# arches-home-init.service expands it to fill the actual card on first boot.
part /home --source empty --ondisk mmcblk1 --fstype=ext4 --label home --align 4096 --fixed-size 512M
