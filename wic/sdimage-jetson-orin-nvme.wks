# Jetson Orin NX / Orin Nano (NVMe) — A/B OTA NVMe layout
#
# These boards (Orin NX, Orin Nano on P3768 carrier, Orin Nano devkit-nvme)
# boot via UEFI firmware stored in QSPI flash on the module.  UEFI scans
# bootable partitions for /boot/extlinux/extlinux.conf.
# The rootfs is placed on the NVMe drive (/dev/nvme0n1).
#
# p1  /boot       256 MB   FAT32  kernel Image, DTBs, extlinux/extlinux.conf
# p2  /           8192 MB  ext4   rootfs-a  (active slot, built by BitBake)
# p3  <none>      8192 MB  ext4   rootfs-b  (standby slot, written by SWUpdate)
# p4  /pst        3072 MB ext4   persistent instrumentation state (survives A/B)
# p5  /home       512 MB → grows to fill drive on first boot via arches-home-init
#
# p5 is mounted at /home so user home directories persist across OTA updates.
# On first boot arches-home-init.service creates /home/arches because the
# fresh empty partition hides the in-rootfs skeleton copy.
#
# SWUpdate writes the new rootfs to the inactive slot (p2 or p3) and
# updates /boot/extlinux/extlinux.conf root= to the new slot's PARTUUID.
# On the next reboot the updated slot becomes active.
#
# The NVMe drive is /dev/nvme0n1 on all NVMe-boot Jetson Orin boards.
# UEFI / boot firmware is stored in QSPI flash — not on NVMe.

part /boot --source bootimg-partition --ondisk nvme0n1 --fstype=vfat --label boot --active --align 4096 --fixed-size 256M

part / --source rootfs --ondisk nvme0n1 --fstype=ext4 --label rootfs-a --align 4096 --fixed-size 8192M

part --source empty --ondisk nvme0n1 --fstype=ext4 --label rootfs-b --align 4096 --fixed-size 8192M

# p4  /pst  — persistent instrumentation state. MUST precede /home: the home
# partition is grown to 100%% of the media on first boot (arches-home-init),
# which is only safe while it is the LAST partition.
#
# 3072 MB is sized from the hard per-consumer budgets in
# Arches-Instrumentation/descriptors/resource-profile-*.yaml -- spool 128 MB,
# logs 256 MB, OTA staging 1024 MB, backups 512 MB = 1920 MB -- plus the
# headroom REQ 6 requires so spool, logs and OTA staging "can never fill the
# partition and wedge the device". It sits outside both rootfs slots so it
# survives an A/B update, which is the whole point: /pst is what the device
# remembers across a reflash.
part /pst --source empty --ondisk nvme0n1 --fstype=ext4 --label pst --align 4096 --fixed-size 3072M

# p5 is created at 512 MB here so the .wic image stays small.
# arches-home-init.service expands it to fill the actual drive on first boot.
part /home --source empty --ondisk nvme0n1 --fstype=ext4 --label home --align 4096 --fixed-size 512M
