# Jetson AGX Orin Developer Kit — A/B OTA eMMC layout
#
# The Jetson AGX Orin boots via UEFI firmware stored in QSPI flash on the
# module.  UEFI scans bootable partitions for /boot/extlinux/extlinux.conf.
# The rootfs is placed on the on-module eMMC (/dev/mmcblk0).
#
# p1  /boot       256 MB   FAT32  kernel Image, DTBs, extlinux/extlinux.conf
# p2  /           8192 MB  ext4   rootfs-a  (active slot, built by BitBake)
# p3  <none>      8192 MB  ext4   rootfs-b  (standby slot, written by SWUpdate)
# p4  /home       512 MB → grows to fill device on first boot via arches-home-init
#
# p4 is mounted at /home so user home directories persist across OTA updates.
# On first boot arches-home-init.service creates /home/arches because the
# fresh empty partition hides the in-rootfs skeleton copy.
#
# SWUpdate writes the new rootfs to the inactive slot (p2 or p3) and
# updates /boot/extlinux/extlinux.conf root= to the new slot's PARTUUID.
# On the next reboot the updated slot becomes active.
#
# The eMMC is /dev/mmcblk0 on all AGX Orin boards.
# UEFI / boot firmware is stored separately in QSPI flash — not on eMMC.

part /boot --source bootimg-partition --ondisk mmcblk0 --fstype=vfat --label boot --active --align 4096 --fixed-size 256M

part / --source rootfs --ondisk mmcblk0 --fstype=ext4 --label rootfs-a --align 4096 --fixed-size 8192M

part --source empty --ondisk mmcblk0 --fstype=ext4 --label rootfs-b --align 4096 --fixed-size 8192M

# p4 is created at 512 MB here so the .wic image stays small.
# arches-home-init.service expands it to fill the actual device on first boot.
part /home --source empty --ondisk mmcblk0 --fstype=ext4 --label home --align 4096 --fixed-size 512M
