[Unit]
Description=SWUpdate boot verification (active slot confirmation)
Documentation=https://sbabic.github.io/swupdate/
After=local-fs.target systemd-remount-fs.service
Before=multi-user.target

[Service]
Type=oneshot
ExecStart=/usr/lib/swupdate/swupdate-bootcheck.sh
RemainAfterExit=yes

[Install]
WantedBy=sysinit.target
